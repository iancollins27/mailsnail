{
  "name": "mailsnail",
  "mcpName": "io.github.iancollins27/mailsnail",
  "version": "0.7.0",
  "description": "MCP server for sending physical mail (USPS letters, postcards, certified mail) from AI agents through your own Click2Mail or Lob account or a self-hosted gateway, with multi-provider failover. Most people want the hosted server instead: https://api.mailsnail.dev/mcp",
  "type": "module",
  "bin": {
    "mailsnail": "src/index.js"
  },
  "main": "src/index.js",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/index.js",
    "smoke": "node src/smoke.js",
    "test": "node src/smoke.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "physical-mail",
    "direct-mail",
    "snail-mail",
    "mailsnail",
    "letters",
    "postcards",
    "certified-mail",
    "usps",
    "click2mail",
    "lob",
    "stripe",
    "agentic-commerce",
    "machine-payments-protocol",
    "ai-agents",
    "claude",
    "cursor",
    "anthropic",
    "open-source",
    "provider-agnostic"
  ],
  "author": "Ian Collins",
  "homepage": "https://mailsnail.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iancollins27/mailsnail.git",
    "directory": "packages/mailsnail"
  },
  "bugs": {
